[
    {
        "name": "url",
        "type": "text",
        "label": "URL",
        "required": true,
        "help": "Enter the part of the URL that comes after `https://mailprobe.dev/api`. For example, `/v1/credits`. For the list of endpoints, see the [MailProbe API documentation](https://mailprobe.dev/api-docs/)."
    },
    {
        "name": "method",
        "type": "select",
        "label": "Method",
        "required": true,
        "default": "GET",
        "options": [
            {
                "label": "GET",
                "value": "GET"
            },
            {
                "label": "POST",
                "value": "POST"
            },
            {
                "label": "PUT",
                "value": "PUT"
            },
            {
                "label": "PATCH",
                "value": "PATCH"
            },
            {
                "label": "DELETE",
                "value": "DELETE"
            }
        ]
    },
    {
        "name": "headers",
        "type": "array",
        "label": "Headers",
        "help": "You don't have to add authorization headers; we already did that for you.",
        "default": [
            {
                "key": "Content-Type",
                "value": "application/json"
            }
        ],
        "spec": [
            {
                "name": "key",
                "type": "text",
                "label": "Key"
            },
            {
                "name": "value",
                "type": "text",
                "label": "Value"
            }
        ]
    },
    {
        "name": "qs",
        "type": "array",
        "label": "Query string",
        "spec": [
            {
                "name": "key",
                "type": "text",
                "label": "Key"
            },
            {
                "name": "value",
                "type": "text",
                "label": "Value"
            }
        ]
    },
    {
        "name": "body",
        "type": "any",
        "label": "Body",
        "help": "Request body, for example `{\"emails\": [\"jane.doe@example.com\"]}` for `POST /v1/verify`."
    }
